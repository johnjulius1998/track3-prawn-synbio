        pathways="results/shortlist/pathways.csv",
        edges="results/shortlist/network_edges.csv",
        taxa="data/processed/clr_profiles/taxa_direction.tsv",
        confound="results/reports/confound_report.tsv"
    output:
        "results/figures/cnsplots/fig1_module_trait_heatmap.svg",
        "results/figures/cnsplots/fig2_ranked_host_genes.svg",
        "results/figures/cnsplots/fig3_ranked_microbial_taxa.svg",
