        "results/figures/cnsplots/fig6_confound_analysis.svg",
        "results/figures/cnsplots/fig7_correction_impact.svg",
        "results/figures/cnsplots/fig8_multipanel_summary.svg"
    resources:
        mem_mb=2048,
        runtime=15
    conda:
        "../environment/conda_environment.yml"
    shell:
        "python pipeline/src/ranking/generate_cnsplots.py"
